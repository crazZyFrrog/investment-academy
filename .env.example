# Public site URL (OG tags, sitemap, Auth.js host)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version 1.0: set to "true" to enable OAuth login + cloud sync
# Requires DATABASE_URL, AUTH_SECRET, AUTH_URL, and at least one OAuth provider.
NEXT_PUBLIC_AUTH_ENABLED=false

# --- Auth + sync (required when NEXT_PUBLIC_AUTH_ENABLED=true) ---
# DATABASE_URL=postgres://user:pass@localhost:5432/investment_academy
# AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# AUTH_URL=http://localhost:3000

# Google OAuth — callback: {AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional) — callback: {AUTH_URL}/api/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Billing (post-1.0 subscriptions)
# BILLING_WEBHOOK_SECRET=generate-a-long-random-string-at-least-32-chars
